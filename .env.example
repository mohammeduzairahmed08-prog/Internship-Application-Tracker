# ========================================================
# Internship Application Tracker - Environment Configuration
# ========================================================
# Copy this file to your local development environment or set
# these environment variables in your terminal / IDE run configuration.

# Server Port
PORT=8080

# MySQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/internship_tracker?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# JPA / Hibernate Configuration (update / validate)
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
